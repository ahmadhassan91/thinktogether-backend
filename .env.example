# Think Together Training MVP API
API_PORT=5174
API_HOST=127.0.0.1
DATABASE_URL=postgresql:///think_training_mvp
CORS_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=
SESSION_TTL_HOURS=12

# Seeded admin user. Replace the password in every non-local environment.
ADMIN_EMAIL=admin@thinktogether.local
ADMIN_PASSWORD=replace-with-a-long-unique-password

# API test database. Used by server/app.test.ts when set.
TEST_DATABASE_URL=postgresql:///think_training_mvp_test

# Optional AI deck-generation providers. Keep real keys in the server environment only.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_DECK_MODEL=gpt-5.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
NOTEBOOKLM_PROJECT_ID=
